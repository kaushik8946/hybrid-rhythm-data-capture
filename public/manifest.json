{
  "manifest_version": 3,
  "name": "Hybrid Rhythm Data Capture",
  "description": "Secure local bridge: captures attendance data from Hybrid Rhythm and makes it available exclusively to Attendance Forecast via origin-verified extension messaging.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chebz162229098.sl2469408.sl.dst.ibm.com/*",
    "https://chebz162229098.sl2469408.sl.dst.ibm.com:9443/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://attendance-forecast.netlify.app/*",
      "http://localhost:5173/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chebz162229098.sl2469408.sl.dst.ibm.com/*",
        "https://chebz162229098.sl2469408.sl.dst.ibm.com:9443/*"
      ],
      "js": ["content-script-loader.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chebz162229098.sl2469408.sl.dst.ibm.com/*",
        "https://chebz162229098.sl2469408.sl.dst.ibm.com:9443/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "48": "icons.svg",
    "128": "icons.svg"
  }
}
